# ============================================
# STAGE 1: Build NestJS Application
# ============================================
FROM node:24-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Generate Prisma client (outputs to src/generated/prisma/) + build NestJS
RUN npx prisma generate && npm run build

# ============================================
# STAGE 2: Production Runtime
# ============================================
FROM node:24-alpine

WORKDIR /app

# Install ONLY production dependencies
COPY package*.json ./
RUN npm ci --omit=dev

# Copy Prisma schema + config (needed for prisma migrate deploy)
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma.config.ts ./prisma.config.ts

# Copy compiled NestJS app (includes generated prisma client in dist/)
COPY --from=builder /app/dist ./dist

# Copy generated Prisma client (runtime needs it from src/generated/)
COPY --from=builder /app/src/generated ./src/generated

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 -G nodejs

# Install curl for healthcheck
RUN apk add --no-cache curl

# Create uploads directory with correct permissions
RUN mkdir -p /app/uploads/projects && chown -R nodejs:nodejs /app

# Copy seed images from builder (if they exist)
COPY --from=builder --chown=nodejs:nodejs /app/uploads /app/uploads

USER nodejs

EXPOSE 3000

# Run Prisma migrations then start the app
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/main.js"]

LABEL maintainer="Thomas kitadevturtle@gmail.com"
LABEL environment="production"
LABEL description="Portfolio backend API — NestJS + Prisma"
